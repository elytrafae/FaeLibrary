ItemConditions: {
	Any: Any
	IsWeapon: Weapons
	IsMeleeWeapon: Melee Weapons
	IsWhipWeapon: Whips
	IsRangedWeapon: Ranged Weapons
	IsMagicWeapon: Magic Weapons
	IsSummonerWeapon: Summoner Weapons
	IsMinionWeapon: Minions
	IsSentryWeapon: Sentries
	IsAccessory: Accessories
	GrammaticalAnd: "{0} and {1}"
	GrammaticalAnd3: "{0}, {1} and {2}"
	Not: Not {0}
	ThisButNotThis: "{0}, but not {1}"
}

ChargesText: Charges: {0}/{1}

Configs: {
	ClientConfig: {
		DisplayName: Client Config

		missingTextureEnabled: {
			Label: Missing Texture Enabled
			Tooltip:
				'''
				If this is enabled, Item, Buff, NPC and Projectile textures that are missing are replaced with a purple and black checkerboard.
				NOTE: Turn this off before publishing a mod!
				For players, it's up to you if you set this on or not...
				'''
		}
	}
}
